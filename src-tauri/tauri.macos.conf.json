{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Piazza",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "trafficLightPosition": {
          "x": 16,
          "y": 21
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "menu"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
