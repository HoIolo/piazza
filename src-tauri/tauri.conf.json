{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piazza",
  "version": "0.1.1",
  "identifier": "com.piazza.app",
  "build": {
    "beforeDevCommand": "node scripts/prepare-pi-runtime.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-pi-runtime.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Piazza",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/task-plan.ts",
      "resources/ask-user-question.ts",
      "resources/pi-runtime/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "基于 pi 的编码助手",
    "longDescription": "基于 pi coding agent 的桌面 GUI",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HoIolo/piazza/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MTE3NzREMjgzMDM2REYKUldUZk5qQW9UWGNSV096RUlxZndaVGorVHFQVWgrQWN1cXRoREJwajZ6SmVwTnJEd29aZWh1dmgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
