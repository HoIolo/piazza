{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piazza",
  "version": "0.1.0",
  "identifier": "com.piazza.app",
  "build": {
    "beforeDevCommand": "bash scripts/prepare-pi-runtime.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/prepare-pi-runtime.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Piazza",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "trafficLightPosition": {
          "x": 16,
          "y": 21
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "menu"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "resources": ["resources/task-plan.ts", "resources/pi-runtime/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "基于 pi 的编码助手",
    "longDescription": "基于 pi coding agent 的桌面 GUI"
  }
}
